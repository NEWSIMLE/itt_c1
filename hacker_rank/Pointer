#include <stdio.h>

void update(int *a,int *b) {
    int vala=*a;
    int valb=*b;
    *a=vala+valb;
    if(vala > valb){
        *b=vala -valb;
    }
    else{
        *b=valb-vala;
    }
}

int main() {
    int a, b;
    int *pa = &a, *pb = &b;
    
    scanf("%d %d", &a, &b);
    update(pa, pb);
    printf("%d\n%d", a, b);

    return 0;
}
